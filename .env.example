# Proficios ortam değişkenleri. Bu dosyayı .env.local olarak kopyalayıp değerleri doldur.
# NEXT_PUBLIC_ ile başlayanlar tarayıcıya gider; diğerleri yalnız sunucuda kalır.

# --- Supabase -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (sb_publishable_…) ya da eski anon anahtarı
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…). Yalnız sunucu: Paddle webhook'u bununla yazar. Asla NEXT_PUBLIC_ yapma.
SUPABASE_SECRET_KEY=

# --- Uygulama ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Gemini (AI SDK) -------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Google Business Profile bağlantısı (yalnız sunucu) ---------------------------
# Supabase Auth'taki Google sağlayıcısında kullanılan OAuth istemcisinin aynısı olmalı.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 rastgele baytın base64 hali. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Değiştirirsen saklanan token'lar çözülemez ve kullanıcılar Google'a yeniden bağlanmak zorunda kalır.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Paddle Billing ---------------------------------------------------------------
# sandbox ya da production
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Sandbox token'ları test_ ile, canlı token'lar live_ ile başlar; ortamla eşleşmeli.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_ANNUAL=
# Paddle → Developer tools → Notifications → ilgili destination'ın secret key'i (pdl_ntfset_…)
PADDLE_WEBHOOK_SECRET_KEY=
